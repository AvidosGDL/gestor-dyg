rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Rules for user avatars
    // Users can only write their own avatar
    // All users can read all avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for chat media
    // Only members of a chat can read/write media for that chat
    match /chat_media/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }
  }
}
