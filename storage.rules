
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Rules for user avatars
    // Users can only write their own avatar
    // All users can read all avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for chat media
    // Only members of a chat can read/write media for that chat
    match /chat_media/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    // Rules for task attachments
    // Allow public read for anyone with the download URL (which includes a security token).
    // Write access requires authentication.
    match /task_attachments/{taskId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // Rules for bank transaction attachments
    // Only authorized users can read/write attachments for bank transactions
    match /bank_attachments/{bankId}/{transactionId}/{fileName} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'fKZUAAXTENPcUeEA4tUXFEV4xbr1' || // daniel@avidos.mx
        request.auth.uid == 'cbXyvN4G98Q7Y9IaJHhec0MyjlT2'    // roberto.d@gygproyectosfiscales.com
      );
    }
  }
}
