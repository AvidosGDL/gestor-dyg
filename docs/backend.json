
{
  "entities": {
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a task or business opportunity.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "client": { "type": "string" },
        "value": { "type": "number" },
        "probability": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "priority": { "type": "string" }
      },
      "required": ["id", "title", "status", "priority"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "User profile with role-based access control.",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "canAccessBanks": { "type": "boolean" },
        "canAccessInvestors": { "type": "boolean" },
        "canAccessProjects": { "type": "boolean" }
      },
      "required": ["uid", "name", "email"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "bankName": { "type": "string" },
        "currentBalance": { "type": "number" }
      }
    },
    "BankTransaction": {
      "title": "BankTransaction",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["ingreso", "egreso"] },
        "sortOrder": { "type": "number" },
        "isAdjustment": { "type": "boolean" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["bug", "improvement"] },
        "description": { "type": "string" },
        "severity": { "type": "number", "enum": [1, 2, 3] },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "browser": { "type": "string" },
        "device": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorEmail": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles and permissions."
    },
    "/banks/{bankId}": {
      "schema": { "$ref": "#/backend/entities/BankAccount" },
      "description": "Bank account definitions."
    },
    "/banks/{bankId}/transactions/{txId}": {
      "schema": { "$ref": "#/backend/entities/BankTransaction" },
      "description": "Movements for a specific bank account."
    },
    "/investors/{investorId}": {
      "schema": { "type": "object" },
      "description": "Investor data."
    },
    "/projects/{projectId}": {
      "schema": { "type": "object" },
      "description": "Project and construction management."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/backend/entities/SupportTicket" },
      "description": "System bug reports and improvement requests."
    }
  }
}
