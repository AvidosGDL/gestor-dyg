
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      },
      "required": ["displayName", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Represents a single task in the task manager.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "client": { "type": "string" },
        "progress": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["backlog", "prospecting", "negotiation", "closing", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "delegateTo": { "type": "string" },
        "description": { "type": "string" },
        "value": { "type": "number" },
        "probability": { "type": "number" }
      },
      "required": ["title", "status", "priority", "progress", "value", "probability"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Represents a member of the user's team.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "auth": {
    "providers": ["email", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/backend/entities/Task"
      },
      "description": "Stores the tasks for a specific user."
    },
    "/users/{userId}/teamMembers/{memberId}": {
      "schema": {
        "$ref": "#/backend/entities/TeamMember"
      },
      "description": "Stores the team members for a specific user."
    }
  }
}
