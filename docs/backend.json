{
  "entities": {
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a task or business opportunity within the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the task."
        },
        "title": {
          "type": "string",
          "description": "Title of the task or business opportunity."
        },
        "client": {
          "type": "string",
          "description": "Name of the client associated with the task."
        },
        "value": {
          "type": "number",
          "description": "Estimated value of the task or business opportunity."
        },
        "probability": {
          "type": "number",
          "description": "Probability of success for the task (percentage)."
        },
        "dueDate": {
          "type": "string",
          "description": "Due date for the task.",
          "format": "date"
        },
        "status": {
          "type": "string",
          "description": "Current status of the task (e.g., backlog, prospecting, negotiation, closing, done)."
        },
        "priority": {
          "type": "string",
          "description": "Priority level of the task (e.g., low, medium, high)."
        },
        "delegateTo": {
          "type": "string",
          "description": "Name of the person to whom the task is delegated."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the task."
        },
        "focusSessions": {
          "type": "array",
          "description": "An array of focus sessions for this task.",
          "items": {
            "type": "object",
            "properties": {
              "startTime": {
                "type": "string",
                "format": "date-time"
              },
              "endTime": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["startTime", "endTime"]
          }
        },
        "completionComment": {
          "type": "string",
          "description": "A comment added when the task is completed."
        },
        "attachments": {
          "type": "array",
          "description": "A list of files attached to the task.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "size": {
                "type": "number"
              }
            },
            "required": ["name", "type", "size"]
          }
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "priority"
      ]
    },
    "TeamMember": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TeamMember",
      "type": "object",
      "description": "Represents a team member in the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the team member."
        },
        "name": {
          "type": "string",
          "description": "Full name of the team member."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the team member."
        },
        "role": {
          "type": "string",
          "description": "Role or position of the team member."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the team member."
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the team member's avatar."
        },
        "authType": {
          "type": "string",
          "enum": ["google", "email"],
          "description": "Authentication method for the team member."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "authType"
      ]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores public profile information for a user.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for the user's avatar image."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the organization."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number."
        }
      },
      "required": ["name", "email", "avatarUrl", "role"]
    },
    "Prospect": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Prospect",
      "type": "object",
      "description": "Represents a new business prospect.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the prospect."
        },
        "name": {
          "type": "string",
          "description": "Name of the prospect."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the prospect."
        },
        "email": {
          "type": "string",
          "description": "Email address of the prospect."
        },
        "businessDescription": {
          "type": "string",
          "description": "Description of the business opportunity."
        },
        "nextContactDate": {
          "type": "string",
          "format": "date",
          "description": "Date for the next follow-up contact."
        },
        "contactLog": {
          "type": "array",
          "description": "A log of all contacts made with the prospect.",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["date", "notes"]
          }
        }
      },
      "required": ["id", "name", "businessDescription"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
     "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public profile information for a user."
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Stores all tasks for all users in a single collection."
    },
    "/users/{userId}/teamMembers/{memberId}": {
      "schema": {
        "$ref": "#/entities/TeamMember"
      },
      "description": "Stores team member data for a specific user."
    },
    "/users/{userId}/prospects/{prospectId}": {
      "schema": {
        "$ref": "#/entities/Prospect"
      },
      "description": "Stores prospect data for a specific user."
    }
  }
}
