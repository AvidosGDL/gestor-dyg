rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /teamMembers/{memberId} {
        allow read, write, create, delete, update: if request.auth != null && request.auth.uid == userId;
      }
      
      match /prospects/{prospectId} {
        allow read, write, create, delete, update: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /tasks/{taskId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.delegateToId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.ownerId) || 
        (request.auth.uid == resource.data.delegateToId && !('ownerId' in request.resource.data) && !('delegateToId' in request.resource.data))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
