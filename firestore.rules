rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /teamMembers/{memberId} {
        allow read, write, create, delete, update: if request.auth != null && request.auth.uid == userId;
      }
      
      match /prospects/{prospectId} {
        allow read, write, create, delete, update: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /tasks/{taskId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.delegateToId);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null &&
                      ( (request.auth.uid == resource.data.ownerId) ||
                        (request.auth.uid == resource.data.delegateToId &&
                         request.resource.data.ownerId == resource.data.ownerId &&
                         request.resource.data.delegateToId == resource.data.delegateToId)
                      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
