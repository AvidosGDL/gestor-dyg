
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'fKZUAAXTENPcUeEA4tUXFEV4xbr1';
    }
    
    function isAuthorizedForInvestors() {
      return isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canAccessInvestors == true;
    }
    
    function isAuthorizedForBanks() {
      return isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canAccessBanks == true;
    }

    function isAuthorizedForProjects() {
      return isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canAccessProjects == true;
    }

    match /invitations/{email} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /users/{userId}/teamMembers/{memberId} {
      allow read, write, delete: if isOwner(userId) || isAdmin() || isSignedIn();
    }
    
    match /users/{userId}/prospects/{prospectId} {
      allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
    }
    
    match /tasks/{taskId} {
      allow read, write, create, update, delete: if isSignedIn();
    }
    
    match /taskHistory/{historyId} {
      allow create, read: if isSignedIn();
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.memberIds);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.memberIds);
      
      match /messages/{messageId} {
        allow read, create, update: if isSignedIn();
      }
    }
    
    match /investors/{investorId} {
      allow read, write, create, update, delete: if isAuthorizedForInvestors();
      
      match /transactions/{transactionId} {
        allow read, write, create, update, delete: if isAuthorizedForInvestors();
      }
    }

    match /banks/{bankId} {
      allow read, write, create, update, delete: if isAuthorizedForBanks();
      
      match /transactions/{transactionId} {
        allow read, write, create, update, delete: if isAuthorizedForBanks();
      }
    }

    match /projects/{projectId} {
      allow read, write, create, update, delete: if isAuthorizedForProjects();
      
      match /activities/{activityId} {
        allow read, write, create, update, delete: if isAuthorizedForProjects();
      }
    }
  }
}
